// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  tasks           Task[]
  planningSignals PlanningSignal[]
}

model Task {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  estimate    Int?
  status      String   @default("todo")
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

enum TaskProposalStatus {
  proposed
  accepted
  rejected
}

model TaskProposal {
  id          String   @id @default(cuid())
  agentRunId  String
  title       String
  description String?
  estimate    Int?
  provenance  String[]
  status      String // "proposed" || "accepted" || "rejected"
  externalRef String? // Github issue url
  createdAt   DateTime @default(now())
  agentRun    AgentRun @relation(fields: [agentRunId], references: [id])
}

model AgentRun {
  id            String         @id @default(cuid())
  agentName     String
  inputJson     Json
  outputJson    Json?
  rawOutput     String?
  status        String         @default("completed")
  createdAt     DateTime       @default(now())
  completedAt   DateTime?
  taskProposals TaskProposal[]
  decisionNotes DecisionNote[]
}

model DecisionNote {
  id         String   @id @default(cuid())
  agentRunId String
  note       String
  createdAt  DateTime @default(now())

  agentRun AgentRun @relation(fields: [agentRunId], references: [id])
}

enum PlanningSignalType {
  goal
  context
  non_goal
  desired_outcome
  completed_work
  decision
}

model PlanningSignal {
  id        String             @id @default(cuid())
  projectId String
  type      PlanningSignalType
  content   String
  source    String // "user" | "system" | "imported"
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())

  project Project @relation(fields: [projectId], references: [id])
}
