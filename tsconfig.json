{
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@pipr/shared/*": ["packages/shared/dist/*"],
      "@pipr/shared": ["packages/shared/dist/index.d.ts"]
    },
    "strict": true,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
