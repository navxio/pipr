{
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["packages/shared/src/*"],
      "@shared": ["packages/shared/src"],
      "@api-types": ["packages/api-types/dist/src"],
      "@api-types/*": ["packages/api-types/dist/src/*"]
    },
    "strict": true,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
