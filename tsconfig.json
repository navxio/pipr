{
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@pipr/domain/*": ["packages/domain/dist/*"],
      "@pipr/domain": ["packages/domain/dist"],
      "@pipr/api": ["packages/api/dist"],
      "@pipr/api/*": ["packages/api/dist/*"]
    },
    "strict": true,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
