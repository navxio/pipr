{
  "name": "pipr",
  "private": true,
  "version": "0.0.2",
  "description": "Project Intelligence and Planning Runtime",
  "main": "index.ts",
  "scripts": {
    "build:shared": "pnpm --filter @pipr/shared build",
    "build:backend": "pnpm --filter pipr-backend build",
    "build:web": "pnpm --filter pipr-web run build",
    "build": "pnpm run build:shared && pnpm run build:backend && pnpm run build:web",
    "dev:backend": "pnpm --filter pipr-backend run dev",
    "dev:web": "pnpm --filter pipr-web run dev",
    "dev": "pnpm run build:shared && concurrently \"pnpm run dev:backend\" \"pnpm run dev:web\"",
    "db:up": "docker compose -f apps/backend/docker-compose.yml up -d",
    "db:down": "docker compose -f apps/backend/docker-compose.yml down",
    "prisma:migrate": "pnpm --filter pipr-backend run prisma:migrate",
    "prisma:generate": "pnpm --filter pipr-backend run prisma:generate",
    "typecheck": "tsc -b",
    "clean": "rm -rf packages/*/dist apps/*/dist **/*.tsbuildinfo"
  },
  "keywords": [
    "llm",
    "ai",
    "pm",
    "project-management",
    "project-manager",
    "manager"
  ],
  "author": "Navdeep Saini",
  "license": "GPLv3",
  "packageManager": "pnpm@10.23.0",
  "volta": {
    "node": "24.11.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
